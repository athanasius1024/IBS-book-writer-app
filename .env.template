# Copy to .env (start.sh and setup_database.sh do this for you). Never commit .env.

# Session signing key. Generated automatically on first run if left blank.
SECRET_KEY=

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_ibs_bookwriter
DB_USER=rock
DB_PASSWORD=
# Schema that holds the tables (must match sql/schema.sql)
BOOKWRITER_SCHEMA=scm_bookwriter
# Or supply a full SQLAlchemy URL instead of the DB_* values:
# DATABASE_URL=postgresql://user:password@localhost:5432/db_ibs_bookwriter

# Accounts: set to 0 to stop new sign-ups once your accounts exist
# (the very first account can always be created).
# ALLOW_REGISTRATION=1

# Set to 1 when serving over HTTPS so the session cookie is HTTPS-only
# SESSION_COOKIE_SECURE=0

# Where uploaded cover images are stored (default: ./uploads)
# UPLOAD_DIR=

# Bind address / port for `python ibsbook.py` (127.0.0.1 = this machine only)
# HOST=127.0.0.1
# PORT=5000

# Development only: auto-reload and debugger. Never enable on a shared server.
# IBS_DEBUG=0
